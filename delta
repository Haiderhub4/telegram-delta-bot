        chat_id=message.chat.id,
        message_id=waiting_msg.message_id,
        text=f"✅ **تم استخراج المفتاح بنجاح يا حيدر!**\n\n`{key}`",
        parse_mode="Markdown",
    )
  else:
    bot.edit_message_text(
        chat_id=message.chat.id,
        message_id=waiting_msg.message_id,
        text="❌ فشل استخراج المفتاح. تأكد من صحة الرابط.",
