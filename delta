def bypass_delta_link(target_url):
  try:
    api_url = f"https://api.delta-bypass.com/api?url={target_url}"
    response = requests.get(api_url, timeout=30)
    if response.status_code == 200:
      data = response.json()
      if "key" in data:
        return data["key"]
      elif "result" in data:
        return data["result"]
    return None
  except Exception as e:
    print(f"Error: {e}")
    return None


